{
  "name": "ai-use-case-to-release",
  "version": "0.1.0",
  "description": "The ADLC spine for one AI use case: qualify → govern → data → model → prompt → evaluate → red-team → guardrails → cost → (AI risk lead approves) → release plan built from the real results.",
  "adlc_stage": ["use-case", "govern", "data", "architecture", "build", "evaluate", "deploy"],
  "inputs": [
    {"name": "answers", "type": "json", "required": true, "from": "use-case canvas answers (layout: skills/ai-platform/ai-use-case-canvas/evals/fixtures/answers.json)"},
    {"name": "data", "type": "csv", "required": true, "from": "a sample of the data the system will use"},
    {"name": "data_requirements", "type": "csv", "required": true, "from": "owner-signed readiness thresholds (key,value)"},
    {"name": "pii_policy", "type": "csv", "required": false, "from": "pii_type,handling; without it handling is TBD with the Privacy officer"},
    {"name": "candidates", "type": "csv", "required": true, "from": "candidate models with your own benchmark scores and prices"},
    {"name": "criteria", "type": "csv", "required": true, "from": "selection criteria, weights, hard constraints"},
    {"name": "model_workload", "type": "csv", "required": false, "from": "tokens per request and volume, for monthly cost per candidate"},
    {"name": "prompt_spec", "type": "json", "required": true, "from": "prompt spec (role, task, variables, output schema, examples)"},
    {"name": "eval_cases", "type": "file", "required": true, "from": "golden eval cases with outputs to score"},
    {"name": "app_profile", "type": "json", "required": true, "from": "red-team profile: purpose, tools, data, canary"},
    {"name": "attack_responses", "type": "csv", "required": true, "from": "the app's responses to the generated attacks"},
    {"name": "guardrail_policy", "type": "json", "required": true, "from": "blocked topics, PII handling, limits, tool allowlist"},
    {"name": "guardrail_tests", "type": "csv", "required": false, "from": "expected allow/block/mask decisions"},
    {"name": "cost_workload", "type": "csv", "required": true, "from": "per-feature requests and tokens"},
    {"name": "prices", "type": "csv", "required": true, "from": "your dated price sheet"},
    {"name": "assignment", "type": "csv", "required": true, "from": "feature → model"},
    {"name": "budget_usd_month", "type": "string", "required": false, "from": "monthly budget"},
    {"name": "release_facts", "type": "csv", "required": true, "from": "facts the earlier steps cannot measure: risk tier, latency, traffic, rollback time, owners"},
    {"name": "gates", "type": "csv", "required": true, "from": "owner-set release gates per stage"}
  ],
  "config": {"provider": "auto", "on_fail": "stop"},
  "steps": [
    {"id": "qualify", "skill": "ai-platform/ai-use-case-canvas", "inputs": {"answers": "$in.answers"}},
    {"id": "govern", "skill": "ai-platform/ai-governance-risk", "inputs": {"canvas": "$steps.qualify:canvas.md"}},
    {"id": "data", "skill": "ai-platform/data-readiness-assessment", "inputs": {"data": "$in.data", "requirements": "$in.data_requirements"}},
    {"id": "pii", "skill": "ai-platform/pii-data-inventory", "inputs": {"data": "$in.data", "policy": "$in.pii_policy"}},
    {"id": "model", "skill": "ai-platform/model-selection", "inputs": {"candidates": "$in.candidates", "criteria": "$in.criteria", "workload": "$in.model_workload"}},
    {"id": "prompt", "skill": "ai-platform/prompt-spec", "inputs": {"spec": "$in.prompt_spec"}},
    {"id": "evaluate", "skill": "ai-platform/llm-eval-harness", "inputs": {"cases": "$in.eval_cases"}},
    {"id": "redteam", "skill": "ai-platform/red-team-suite", "inputs": {"profile": "$in.app_profile", "responses": "$in.attack_responses", "threshold": "0.8"}},
    {"id": "guardrails", "skill": "ai-platform/guardrails-config", "inputs": {"policy": "$in.guardrail_policy", "tests": "$in.guardrail_tests"}},
    {"id": "cost", "skill": "ai-platform/llm-cost-model", "inputs": {"workload": "$in.cost_workload", "prices": "$in.prices", "assignment": "$in.assignment", "budget_usd_month": "$in.budget_usd_month"}},
    {"id": "risk-signoff", "approval": {"role": "AI risk lead", "note": "Review governance register, PII inventory, red-team scorecard and guardrails before a release plan is drawn up."}},
    {"id": "facts", "compose": {"out": "facts.csv", "format": "kv-csv", "include": "$in.release_facts",
      "rows": {"system_name": "$steps.qualify:score.json#name",
               "eval_pass_rate": "$steps.evaluate:scorecard.json#overall_pass_rate",
               "redteam_pass_rate": "$steps.redteam:redteam-scorecard.json#overall.pass_rate"}}},
    {"id": "release", "gate": true, "skill": "ai-platform/ai-release-plan", "inputs": {"facts": "$steps.facts:facts.csv", "gates": "$in.gates"}}
  ],
  "outputs": ["$steps.release:release-plan.md", "$steps.govern:risk-register.csv", "$steps.redteam:redteam-report.md", "$steps.cost:cost-model.md", "$steps.model:decision.md"]
}
