+// Order queries: a fictional in-memory store so the skeleton needs no database yet.
+const ORDERS = [
+  { id: "ord_1001", customer: "Alder & Co", total: 120.5, status: "paid" },
+  { id: "ord_1002", customer: "Birch Ltd", total: 80.0, status: "open" },
+];
+
+export async function listOrders({ limit = 50 } = {}) {
+  return ORDERS.slice(0, limit);
+}
+
+export function ordersToCsv(orders) {
+  const header = "id,customer,total,status";
+  const rows = orders.map((o) => [o.id, quote(o.customer), o.total.toFixed(2), o.status].join(","));
+  return [header, ...rows].join("\n") + "\n";
+}
+
+function quote(value) {
+  const text = String(value ?? "");
+  return /[",\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
