+import { describe, it, expect } from "vitest";
+import { ordersToCsv } from "@/lib/orders";
+
+describe("ordersToCsv", () => {
+  it("writes a header and one row per order", () => {
+    const csv = ordersToCsv([{ id: "ord_1", customer: "Alder & Co", total: 1.5, status: "paid" }]);
+    expect(csv).toBe("id,customer,total,status\nord_1,Alder & Co,1.50,paid\n");
+  });
+  it("quotes a customer name containing a comma", () => {
+    expect(ordersToCsv([{ id: "o", customer: "A, B", total: 0, status: "open" }])).toContain('"A, B"');
+  });
+});
