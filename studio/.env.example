# Supabase (public values; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://ysesfztvcexufoogjgth.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…
# Shared secret between the Next server and the Python runtime (openssl rand -hex 32)
SF_RUNTIME_SECRET=
# Optional: enables llm steps on the server runtime
ANTHROPIC_API_KEY=
# Optional: runtime base URL (vercel dev → http://localhost:3000)
SF_RUNTIME_URL=

# observability (added by observability-setup/scripts/install.py)
HEALTH_CHECK_TOKEN=  # bearer token required by /api/health/deep (generate: openssl rand -hex 32)
LOG_LEVEL=  # debug|info|warn|error (default: info in production, debug elsewhere)
LOG_PRETTY=  # 1 to pretty-print logs in local development
SERVICE_NAME=  # service label on every log line (default: web)

# delivery pipelines (docs/DELIVERY-PIPELINES.md) — Build → Deliver dispatches .github/workflows/delivery.yml in the library
DELIVERY_GITHUB_TOKEN=  # fine-grained PAT or GitHub App token with Actions: write on the library repo; unset → runs stay queued with a notice (run scripts/deliver.py from an IDE)
DELIVERY_GITHUB_REPO=  # owner/name holding delivery.yml (default: giritharanchockalingam/giri-skills)
DELIVERY_GITHUB_REF=  # branch of that repo to run the workflow from (default: main)
# GitHub Actions secrets on the giri-skills repository (not env here) — .github/workflows/delivery.yml, DELIVERY-PIPELINES.md "Where it runs":
#   DELIVERY_TOKEN     token with contents: write + pull-requests: write on the target repos (checkout, push deliver/<run-id>, gh pr create)
#   ANTHROPIC_API_KEY  Claude Code build step and model steps of the skills (--provider anthropic)
#   SF_API_KEY         a portal API key (sf_live_…) created by a member holding the pipeline's role; the executor posts stage records and polls approvals with it
