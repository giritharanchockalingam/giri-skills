{
  "input": {
    "stacks": [
      "github-actions",
      "nextjs",
      "react",
      "tests"
    ],
    "request_kind": "fix",
    "mode": null,
    "stages": null,
    "name": "fix-js-aws"
  },
  "pipeline": {
    "name": "fix-js-aws",
    "version": "0.1.0",
    "title": "Composed fix pipeline for github-actions, nextjs, react, tests",
    "description": "Composed by scripts/compose_pipeline.py: fix request on a brownfield github-actions, nextjs, react, tests stack \u2014 stages build, evaluate, deploy, operate; the step wiring is the shipped templates'.",
    "mode": "brownfield",
    "fits": {
      "stacks": [
        "github-actions",
        "nextjs",
        "react",
        "tests"
      ],
      "request_kinds": [
        "fix"
      ]
    },
    "inputs": [
      {
        "name": "repo",
        "type": "repo",
        "required": true,
        "from": "catalog repository (owner/name) or a local checkout"
      },
      {
        "name": "ref",
        "type": "string",
        "required": false,
        "from": "branch or commit to start from (default: the checkout as it is)"
      },
      {
        "name": "request",
        "type": "text",
        "required": true,
        "from": "the request in the requester's words"
      },
      {
        "name": "brief",
        "type": "json",
        "required": false,
        "from": "product brief for product-spec-prd (layout: skills/build/product-spec-prd/assets/brief-template.json); may carry `files` or `tasks`"
      }
    ],
    "stack_profile": {
      "from": "repo",
      "detect": "scripts/stack_profile.py"
    },
    "stages": [
      {
        "id": "build",
        "adlc_stage": "build",
        "role": "full-stack-engineer",
        "steps": [
          {
            "id": "brief",
            "kind": "compose",
            "derive": "brief-from-request",
            "inputs": {
              "request": "$in.request",
              "brief": "$in.brief"
            },
            "outputs": [
              "brief.json"
            ]
          },
          {
            "id": "spec",
            "kind": "compose",
            "derive": "spec-from-prd",
            "inputs": {
              "brief": "$steps.brief:brief.json",
              "request": "$in.request"
            },
            "outputs": [
              "spec.md",
              "spec.json"
            ]
          },
          {
            "id": "files",
            "kind": "agent",
            "agent": "claude-code",
            "inputs": {
              "plan": "$steps.spec:spec.md",
              "target": "$repo"
            },
            "produces": [
              "files.txt"
            ]
          },
          {
            "id": "code",
            "kind": "agent",
            "agent": "claude-code",
            "inputs": {
              "plan": "$steps.spec:spec.md",
              "files": "$steps.files:files.txt",
              "target": "$repo"
            },
            "constraints": [
              "skills/build/nextjs-enterprise-conventions/SKILL.md",
              "shared/stack-conventions.md"
            ]
          },
          {
            "id": "conventions",
            "kind": "skill",
            "skill": "build/nextjs-enterprise-conventions",
            "inputs": {
              "target": "$repo",
              "baseline": "$profile.baselines.nextjs"
            },
            "gate": true
          }
        ],
        "gate": {
          "kind": "exit",
          "step": "conventions"
        },
        "evidence": [
          "$steps.brief:brief.json",
          "$steps.files:files.txt",
          "$steps.code:diff.patch",
          "$steps.code:agent-summary.md",
          "$steps.conventions:report.md"
        ]
      },
      {
        "id": "evaluate",
        "adlc_stage": "evaluate",
        "role": "ai-quality-red-team",
        "steps": [
          {
            "id": "review",
            "kind": "skill",
            "skill": "build/code-review-runner",
            "inputs": {
              "diff": "$steps.code:diff.patch"
            }
          },
          {
            "id": "security",
            "kind": "skill",
            "skill": "build/security-review",
            "inputs": {
              "diff": "$steps.code:diff.patch",
              "draft_only": "$run.draft_only"
            }
          },
          {
            "id": "perf",
            "kind": "skill",
            "skill": "build/perf-review-runner",
            "inputs": {
              "target": "$repo",
              "baseline": "$profile.baselines.perf"
            }
          },
          {
            "id": "ui",
            "kind": "skill",
            "skill": "build/ui-component-quality",
            "inputs": {
              "target": "$repo",
              "baseline": "$profile.baselines.ui"
            }
          }
        ],
        "gate": {
          "kind": "all",
          "of": [
            {
              "kind": "output",
              "step": "review",
              "file": "review.md",
              "check": "contains:\"Verdict: **PASS**\""
            },
            {
              "kind": "exit",
              "step": "security"
            },
            {
              "kind": "exit",
              "step": "perf"
            },
            {
              "kind": "exit",
              "step": "ui"
            }
          ]
        },
        "evidence": [
          "$steps.review:review.md",
          "$steps.security:security-review.md",
          "$steps.perf:report.md",
          "$steps.ui:report.md"
        ]
      },
      {
        "id": "deploy",
        "adlc_stage": "deploy",
        "role": "mlops-platform-engineer",
        "steps": [
          {
            "id": "ci",
            "kind": "skill",
            "skill": "build/ci-cd-vercel-github",
            "inputs": {
              "target": "$repo"
            }
          },
          {
            "id": "pr",
            "kind": "pr",
            "title": "$in.request",
            "branch": "deliver/$run.id",
            "body": "$evidence"
          }
        ],
        "gate": {
          "kind": "external",
          "what": "CI green on the pull request"
        },
        "evidence": [
          "$steps.ci:ci-report.md",
          "$steps.pr:pr.json"
        ]
      },
      {
        "id": "operate",
        "adlc_stage": "operate",
        "role": "ai-ops-sre",
        "steps": [
          {
            "id": "handoff",
            "kind": "skill",
            "skill": "build/handoff-and-thread-close",
            "inputs": {
              "target": "$repo",
              "state": "$run.state"
            }
          }
        ],
        "gate": {
          "kind": "output",
          "step": "handoff",
          "file": "HANDOFF.md",
          "check": "exists"
        },
        "evidence": [
          "$steps.handoff:HANDOFF.md"
        ]
      }
    ],
    "outputs": [
      "$steps.pr:pr.json",
      "$evidence"
    ],
    "composed": {
      "request_kind": "fix",
      "stacks": [
        "github-actions",
        "nextjs",
        "react",
        "tests"
      ],
      "notes": []
    }
  },
