{
  "name": "giri-skills-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "predev": "node scripts/ingest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ingest.mjs",
    "build": "next build",
    "start": "next start",
    "start:static": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:py": "python3 -m pytest tests/test_factory_runtime.py -q",
    "test:sql": "bash tests/sql/run.sh",
    "test": "npm run typecheck && npm run test:unit && npm run test:py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
