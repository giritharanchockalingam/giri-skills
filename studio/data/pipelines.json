     "of": [
      {
       "kind": "output",
       "step": "review",
       "file": "review.md",
       "check": "contains:\"Verdict: **PASS**\""
      },
      {
       "kind": "exit",
       "step": "security"
      },
      {
       "kind": "exit",
       "step": "perf"
      },
      {
