      "kind": "compose"
     },
     {
      "id": "tests",
      "kind": "skill",
      "skill": "build/test-strategy-tdd"
     },
     {
      "id": "code",
      "kind": "agent"
     },
     {
      "id": "conventions",
      "kind": "skill",
      "skill": "build/nextjs-enterprise-conventions"
     }
    ],
    "gate": {
     "kind": "exit",
     "step": "conventions"
    }
   },
   {
    "id": "evaluate",
    "adlc_stage": "evaluate",
    "role": "ai-quality-red-team",
    "steps": [
     {
      "id": "review",
      "kind": "skill",
      "skill": "build/code-review-runner"
     },
     {
      "id": "security",
      "kind": "skill",
      "skill": "build/security-review"
     },
     {
      "id": "perf",
      "kind": "skill",
      "skill": "build/perf-review-runner"
     },
     {
