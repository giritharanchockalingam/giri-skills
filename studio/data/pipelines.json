      "kind": "compose"
     },
     {
      "id": "plan",
      "kind": "skill",
      "skill": "build/spec-to-plan"
     },
     {
      "id": "plan-approval",
      "kind": "approval"
     }
    ],
    "gate": {
     "kind": "approval",
     "step": "plan-approval"
    }
   },
   {
    "id": "build",
    "adlc_stage": "build",
    "role": "full-stack-engineer",
    "steps": [
     {
