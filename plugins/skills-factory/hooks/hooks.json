{
  "description": "Before a Skills Factory skill loads (tool call or typed slash command) or its scripts run: check its files against the approved hash (block if changed) and report the use.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/governed_skill.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/governed_skill.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
