[
  {
    "name": "search_tickets",
    "description": "Search support tickets by status, assignee and date. Use before reading or updating a ticket. Do not use to create tickets.",
    "inputSchema": {"type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"type": "string", "enum": ["open", "pending", "closed"]},
                     "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}}},
    "outputSchema": {"type": "object", "required": ["status"],
      "properties": {"status": {"type": "string", "enum": ["ok", "error"]}, "data": {"type": "object"}}},
    "failure_modes": ["TIMEOUT: downstream slow -> retryable", "RATE_LIMITED: burst above 60/min"],
    "x-contract": {"version": "1.0.0", "side_effect": "read", "idempotent": true, "scopes": ["tickets:read"], "timeout_ms": 5000}
  },
  {
    "name": "update_ticket",
    "description": "Update one ticket's status or assignee. Irreversible for closed tickets; requires a prepare token from prepare_update.",
    "inputSchema": {"type": "object", "additionalProperties": false, "required": ["ticket_id", "prepare_token"],
      "properties": {"ticket_id": {"type": "string", "pattern": "^T[0-9]{6}$"}, "prepare_token": {"type": "string"},
                     "status": {"type": "string", "enum": ["open", "pending", "closed"]}}},
    "outputSchema": {"type": "object", "required": ["status"],
      "properties": {"status": {"type": "string", "enum": ["ok", "error"]}, "error": {"type": "object"}}},
    "failure_modes": ["INVALID_ARGUMENT: commit without prepare token", "CONFLICT: expired token"],
    "x-contract": {"version": "1.0.0", "side_effect": "irreversible", "idempotent": true, "idempotency_key_input": "prepare_token",
                   "two_phase": true, "scopes": ["tickets:write"], "timeout_ms": 8000}
  }
]
