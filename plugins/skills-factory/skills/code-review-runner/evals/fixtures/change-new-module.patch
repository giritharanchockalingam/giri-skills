+import { describe, it, expect } from "vitest";
+import { pointsFor } from "../points";
+
+describe("pointsFor", () => {
+  it("earns one point per whole dollar on standard", () => {
+    expect(pointsFor({ amountCents: 1999, tier: "standard" })).toBe(19);
+  });
+  it("doubles points on gold", () => {
+    expect(pointsFor({ amountCents: 1000, tier: "gold" })).toBe(20);
+  });
+  it("rejects a negative amount", () => {
+    expect(() => pointsFor({ amountCents: -1, tier: "gold" })).toThrow(RangeError);
+  });
+});
