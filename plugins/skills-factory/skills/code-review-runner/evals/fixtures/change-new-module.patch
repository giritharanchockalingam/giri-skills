+export interface Purchase {
+  amountCents: number;
+  tier: "standard" | "gold";
+}
+
+const RATE: Record<Purchase["tier"], number> = { standard: 1, gold: 2 };
+
+export function pointsFor(p: Purchase): number {
+  if (!Number.isInteger(p.amountCents) || p.amountCents < 0) {
+    throw new RangeError("amountCents must be a non-negative integer");
+  }
+  return Math.floor(p.amountCents / 100) * RATE[p.tier];
+}
+
