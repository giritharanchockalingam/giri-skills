    {"name": "Support tickets asking for export", "baseline": "[TO BE BASELINED — owner: support lead]", "target": "-80%", "source": "helpdesk tag export"}
  ],
  "phases": [
    {"name": "v1", "scope": ["CSV export of the current filter", "Admin role only", "Audit entry per export"], "excludes": ["Scheduling", "XLSX"], "exit": "40% of active tenants exported at least once in 30 days"},
    {"name": "v1.1", "scope": ["Date-range picker", "Column selection"], "exit": "needs evidence: ticket volume"},
    {"name": "Later", "scope": ["Scheduled exports to email"], "exit": "needs evidence: customer requests"}
  ],
  "evidence": [{"claim": "11 tickets in Q3 asked for an export", "source": "helpdesk report Q3", "date": "2026-10-01"}],
