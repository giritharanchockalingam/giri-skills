{
  "feature": "Invoice export",
  "problem": "Tenant admins copy invoices into spreadsheets by hand every month-end because the app has no export",
  "users": ["Tenant admin", "Finance analyst (viewer)"],
  "goals": ["Admins export a month of invoices in one click", "Exports never leak another tenant's rows"],
