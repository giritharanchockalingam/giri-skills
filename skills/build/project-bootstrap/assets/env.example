# .env.example — the env contract. Every variable documented; NO values.
# Copy to .env.local for development. Parsed by lib/env.ts (zod) at boot; missing required vars fail the build.
# Prefix NEXT_PUBLIC_ ONLY for values safe to ship to the browser.

# --- App ---
NEXT_PUBLIC_APP_URL=            # required | public | canonical URL, e.g. http://localhost:3000
NODE_ENV=                        # set by runtime | development|test|production
LOG_LEVEL=                       # optional | server | debug|info|warn|error (default info)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=        # required | public | project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # required | public | anon key (RLS-enforced)
SUPABASE_SERVICE_ROLE_KEY=       # required | SERVER ONLY | bypasses RLS; never NEXT_PUBLIC_, never in client dirs
SUPABASE_DB_URL=                 # optional | server | direct Postgres URL for migrations/integration tests

# --- Observability ---
SENTRY_DSN=                      # optional | server | error tracking
NEXT_PUBLIC_SENTRY_DSN=          # optional | public | browser error tracking
HEALTH_CHECK_TOKEN=              # optional | server | bearer token for /api/health/deep

# --- Feature flags ---
FEATURE_FLAGS=                   # optional | server | comma-separated enabled flags, e.g. billing,exports

# --- CI only (GitHub secrets, never in .env.local) ---
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD, SUPABASE_PROJECT_REF_STAGING, SUPABASE_PROJECT_REF_PROD
