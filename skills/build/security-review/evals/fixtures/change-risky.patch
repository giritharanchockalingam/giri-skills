new file mode 100644
--- /dev/null
+++ b/server/actions/export-invoices.ts
@@ -0,0 +1,12 @@
+"use server";
+import { db } from "@/lib/db";
+
+export async function exportInvoices(tenantId: string, status: string) {
+  const rows = await db.query(`select * from invoices where tenant_id = '${tenantId}' and status = '${status}'`);
+  return rows;
+}
+
+export async function fetchRemoteReport(url: string) {
+  const res = await fetch(url);
+  return res.text();
+}
