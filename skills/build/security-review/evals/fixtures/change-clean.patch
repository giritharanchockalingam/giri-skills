diff --git a/server/actions/create-invoice.ts b/server/actions/create-invoice.ts
new file mode 100644
--- /dev/null
+++ b/server/actions/create-invoice.ts
@@ -0,0 +1,12 @@
+"use server";
+import { z } from "zod";
+import { requireUser } from "@/lib/auth";
+import { createInvoice } from "@/server/services/invoice-service";
+
+const Input = z.object({ number: z.string().min(1), amount: z.number().int().positive() });
+
+export async function createInvoiceAction(raw: unknown) {
+  const input = Input.parse(raw);
+  const user = await requireUser();
+  return createInvoice(user.tenantId, input);
+}
