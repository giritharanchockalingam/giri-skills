{
  "name": "search_tickets",
  "description": "Search support tickets by status and date. Use before reading or updating a ticket.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "open",
          "pending",
          "closed"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "status"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ]
      },
      "data": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        }
      }
    }
  },
  "x-contract": {
    "side_effect": "read",
    "idempotent": true,
    "scopes": [
      "tickets:read"
    ],
    "timeout_ms": 5000
  }
}
